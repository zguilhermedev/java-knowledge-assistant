# Usado pelo Docker Compose. Maven/Spring Boot não leem .env automaticamente.
# As credenciais abaixo são somente para o banco de desenvolvimento deste projeto.
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=knowledge_assistant_local
OLLAMA_PORT=11534

# Exporte no terminal/IDE se quiser alterar os padrões da aplicação.
SERVER_PORT=8082
OLLAMA_BASE_URL=http://localhost:11534
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433
PGVECTOR_DATABASE=knowledge_assistant
PGVECTOR_USER=knowledge_assistant
PGVECTOR_PASSWORD=knowledge_assistant_local
PGVECTOR_TABLE=knowledge_embeddings_nomic_v15
PGVECTOR_DIMENSION=768
KNOWLEDGE_CORPUS_PATH=docs/corpus
